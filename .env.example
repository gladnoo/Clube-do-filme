# Copie este arquivo para ".env" e preencha os valores.

# Banco de dados. Em dev local, SQLite já funciona sem mudar nada:
DATABASE_URL="file:./dev.db"

# Gere um valor aleatório com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Sua chave da API do TMDB (The Movie Database).
# Crie de graça em: https://www.themoviedb.org/settings/api
TMDB_API_KEY="cole-sua-chave-aqui"
